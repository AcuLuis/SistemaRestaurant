	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="descripArea" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     Contrato."contratoID" AS Contrato_contratoID,
     Contrato."empleadoID" AS Contrato_empleadoID,
     Contrato."rolID" AS Contrato_rolID,
     Area."descripArea" AS Area_descripArea,
     Contrato."fechaIni" AS Contrato_fechaIni,
     Contrato."fechaFin" AS Contrato_fechaFin,
     Contrato."estado" AS Contrato_estado,
     Contrato."sueldo" AS Contrato_sueldo
FROM
     "dbo"."Area" Area INNER JOIN "dbo"."Contrato" Contrato ON Area."areaID" = Contrato."areaID"
WHERE 
      Area."descripArea" = $P{descripArea}]]>
	</queryString>
	<field name="Contrato_contratoID" class="java.lang.Integer"/>
	<field name="Contrato_empleadoID" class="java.lang.Integer"/>
	<field name="Contrato_rolID" class="java.lang.Integer"/>
	<field name="Area_descripArea" class="java.lang.String"/>
	<field name="Contrato_fechaIni" class="java.sql.Date"/>
