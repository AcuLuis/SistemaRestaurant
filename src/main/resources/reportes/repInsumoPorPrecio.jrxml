<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="null" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="2e6b15ef-4a70-4610-a191-6a6ec9a562eb">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="precioMin" class="java.lang.Double">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="precioMax" class="java.lang.Double">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     Insumo."insumoID" AS Insumo_insumoID,
     (SELECT ti.descripcion FROM TipInsumo ti WHERE ti.idTipInsumo = Insumo."idTipInsumo") AS Insumo_idTipInsumo,
     Insumo."unidadMedida" AS Insumo_unidadMedida,
     Insumo."descripInsumo" AS Insumo_descripInsumo,
     Insumo."precioUnit" AS Insumo_precioUnit,
     Insumo."cantidad" AS Insumo_cantidad
FROM
     "dbo"."Insumo" Insumo
Where
     Insumo."precioUnit"  >= $P{precioMin} and Insumo."precioUnit" <= $P{precioMax}]]>
	</queryString>
	<field name="Insumo_insumoID" class="java.lang.Integer"/>
	<field name="Insumo_idTipInsumo" class="java.lang.String"/>
	<field name="Insumo_unidadMedida" class="java.lang.String"/>
	<field name="Insumo_descripInsumo" class="java.lang.String"/>
	<field name="Insumo_precioUnit" class="java.math.BigDecimal"/>
	<field name="Insumo_cantidad" class="java.math.BigDecimal"/>
