	<queryString language="SQL">
		<![CDATA[select p.productoID, pla.descPlato, t.descripcion, p.cantidad, p.precioUnit 
from TipProducto as t inner join Producto as p on t.idTipProducto = p.idTipProducto
inner join Plato as pla on pla.idPlato = p.idPlato]]>
	</queryString>
