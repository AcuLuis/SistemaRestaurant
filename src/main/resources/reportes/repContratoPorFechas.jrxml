	<parameter name="fechaFin" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     Contrato."contratoID" AS Contrato_contratoID,
     Contrato."empleadoID" AS Contrato_empleadoID,
     Contrato."rolID" AS Contrato_rolID,
     Contrato."areaID" AS Contrato_areaID,
     Contrato."fechaIni" AS Contrato_fechaIni,
     Contrato."fechaFin" AS Contrato_fechaFin,
     Contrato."estado" AS Contrato_estado,
     Contrato."sueldo" AS Contrato_sueldo
FROM
     "dbo"."Contrato" Contrato
WHERE
     Contrato."fechaIni">= $P{fechaIni} and 
     Contrato."fechaFin" <= $P{fechaFin}]]>
	</queryString>
	<field name="Contrato_contratoID" class="java.lang.Integer"/>
	<field name="Contrato_empleadoID" class="java.lang.Integer"/>
