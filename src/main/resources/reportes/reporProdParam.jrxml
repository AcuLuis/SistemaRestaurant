	<parameter name="parPrecMin" class="java.lang.Double">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="parPrecMax" class="java.lang.Double">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     Producto."productoID" AS Producto_productoID,
     Producto."descripProducto" AS Producto_descripProducto,
     Producto."cantidad" AS Producto_cantidad,
     Producto."precioUnit" AS Producto_precioUnit,
     Producto."IdPlato" AS Producto_IdPlato,
     Producto."idTipProducto" AS Producto_idTipProducto
FROM
     "dbo"."Producto" Producto
WHERE
     producto."precioUnit">=$P{parPrecMin} and
     producto."precioUnit"<=$P{parPrecMax}]]>
	</queryString>
	<field name="Producto_productoID" class="java.lang.Integer"/>
