	<queryString language="SQL">
		<![CDATA[SELECT
     Producto."productoID" AS Producto_productoID,
     Producto."descripProducto" AS Producto_descripProducto,
     Producto."cantidad" AS Producto_cantidad,
     Producto."precioUnit" AS Producto_precioUnit,
     (SELECT pl.descPlato FROM Plato pl WHERE pl.idPlato = Producto."idPlato") AS Producto_IdPlato,
     (SELECT tp.descripcion FROM TipProducto tp WHERE tp.idTipProducto = Producto."idTipProducto") AS Producto_idTipProducto
FROM
     "dbo"."Producto" Producto]]>
	</queryString>
